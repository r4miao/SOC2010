# Keep only the syllabus materials and the published, converted course site.
/*
!.gitignore

# Converted HTML and the assets it needs to render.
!/course-site/
/course-site/**
!/course-site/**/
!/course-site/**/*.html
!/course-site/assets/
!/course-site/assets/**

# Syllabus source files are retained, except PDFs below.
!/syllabus/
!/syllabus/**

# PDFs remain local-only, including the syllabus PDF.
*.pdf

# Finder metadata and extraction byproducts are not course-site assets.
**/.DS_Store
